{
  "info": {
    "name": "Student Management API",
    "_postman_id": "student-management-api-v2",
    "description": "Complete API collection for Student Management Application.\n\n## How to Use\n1. Run the **Login** request first.\n2. The JWT token is automatically saved to the `jwt_token` collection variable.\n3. All other requests use `{{jwt_token}}` for Bearer auth automatically.\n4. Use `{{base_url}}` variable (default: http://localhost:3000) to switch environments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" },
    { "key": "teacher_id", "value": "2", "type": "string" },
    { "key": "student_id", "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (POST /api/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var body = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', body.token);",
                  "    pm.test('Login successful and token saved', function() {",
                  "        pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    });",
                  "} else {",
                  "    pm.test('Login failed', function() {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"email\": \"teacher@gmail.com\",\n    \"password\": \"password\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
          }
        },
        {
          "name": "Logout (DELETE /api/logout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('jwt_token', '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/logout", "host": ["{{base_url}}"], "path": ["api", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Teacher APIs",
      "item": [
        {
          "name": "GET /api/teachers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function() { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/teachers", "host": ["{{base_url}}"], "path": ["api", "teachers"] }
          }
        },
        {
          "name": "GET /api/teachers/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 404', function() { pm.expect([200, 404]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has students array', function() { pm.expect(pm.response.json()).to.have.property('students'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/teachers/{{teacher_id}}", "host": ["{{base_url}}"], "path": ["api", "teachers", "{{teacher_id}}"] }
          }
        },
        {
          "name": "POST /api/teachers (Create Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function() { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('teacher_id', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Smith\",\n  \"email\": \"john.smith@example.com\",\n  \"password\": \"password123\",\n  \"subject\": \"Mathematics\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/teachers", "host": ["{{base_url}}"], "path": ["api", "teachers"] }
          }
        },
        {
          "name": "PUT /api/teachers/:id (Update Teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function() { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Physics\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/teachers/{{teacher_id}}", "host": ["{{base_url}}"], "path": ["api", "teachers", "{{teacher_id}}"] }
          }
        },
        {
          "name": "DELETE /api/teachers/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204 No Content', function() { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/teachers/{{teacher_id}}", "host": ["{{base_url}}"], "path": ["api", "teachers", "{{teacher_id}}"] }
          }
        },
        {
          "name": "GET /api/teachers?subject=Math (Filter by Subject)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.test('Response is array', function() { pm.expect(pm.response.json()).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/teachers?subject=Math",
              "host": ["{{base_url}}"],
              "path": ["api", "teachers"],
              "query": [{ "key": "subject", "value": "Math" }]
            }
          }
        }
      ]
    },
