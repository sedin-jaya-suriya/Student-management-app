<%= turbo_stream.replace dom_id(@student) do %>
  <tr id="<%= dom_id(@student) %>">
    <td colspan="7">
      <div class="card p-3 my-2">
        <h5 class="mb-3"><i class="bi bi-pencil-square me-1"></i> Edit Student</h5>
        <%= render "form", student: @student %>
      </div>
    </td>
  </tr>
<% end %>
