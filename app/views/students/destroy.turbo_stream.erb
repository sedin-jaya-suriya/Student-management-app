<%# Remove the student row from the table %>
<%= turbo_stream.remove dom_id(@student) %>

<%# Update the student counter %>
<%= turbo_stream.update "student_count", student_scope.count %>

<%# Show success flash message %>
<%= turbo_stream.update "flash_messages" do %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle me-1"></i> Student was deleted successfully.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
