<%= turbo_frame_tag "students_table" do %>

  <div class="card p-3 mb-3">
    <div class="row g-2 align-items-center">

      <div class="col-md-6">
        <%= form_with url: students_path,
                      method: :get,
                      data: {
                        turbo_frame: "students_table",
                        controller: "live-search",
                        live_search_delay_value: 300
                      } do %>

          <div class="input-group">
            <span class="input-group-text">
              <i class="bi bi-search"></i>
            </span>

            <%= text_field_tag :search,
                  params[:search],
                  placeholder: "Search by name or email",
                  class: "form-control",
                  autofocus: params[:search].present?,
                  data: {
                    action: "input->live-search#search"
                  } %>

            <% if params[:search].present? %>
              <%= link_to "Clear",
                    students_path,
                    class: "btn btn-outline-danger",
                    data: { turbo_frame: "students_table" } %>
            <% end %>
          </div>

        <% end %>
      </div>

      <div class="col-md-4">
        <%= form_with url: students_path,
                      method: :get,
                      data: { turbo_frame: "students_table" } do %>

          <div class="input-group">
            <span class="input-group-text">
              <i class="bi bi-filter"></i>
            </span>

            <%= select_tag :course,
                  options_for_select(Student::COURSES, params[:course]),
                  include_blank: "All Courses",
                  class: "form-select" %>

            <button class="btn btn-outline-secondary" type="submit">
              Filter
            </button>
          </div>

        <% end %>
      </div>

    </div>
  </div>

  <div class="card p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Age</th>
            <th>Course</th>
            <th>City</th>
            <th>Marks</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>

        <tbody id="students_tbody">
          <% if @students.any? %>
            <%= render partial: "student", collection: @students %>
          <% else %>
            <tr id="no_students_row">
              <td colspan="7" class="text-center py-4">
                <div class="text-muted">
                  No students found.
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

<% end %>